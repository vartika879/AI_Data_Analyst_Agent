# ---------------------------------------------------------------------------
# API keys. Never share or commit this file's real values (.env).
# ---------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# Optional second Groq key. It is tried when the first key hits a temporary
# error (for example a rate limit). IMPORTANT: Groq rate limits apply per
# ORGANIZATION (and per model), not per key. Two keys from the same Groq
# organization share one limit, so the second key only helps if it belongs to
# a different organization. Leave empty if you have just one.
GROQ_API_KEY_2=

# Other providers are optional (set a role's *_PROVIDER to use them):
# GEMINI_API_KEY=your_gemini_api_key_here

MAX_UPLOAD_MB=5

# ---------------------------------------------------------------------------
# Retry. After a temporary error (rate limit, timeout, network or server
# error) the request is tried again. A wrong key or model is never retried.
# With two keys, the second key is tried at once; the app waits only after both
# have failed. It waits as long as the provider asks (retry-after), otherwise
# 2 s, 4 s, 8 s ... up to LLM_RETRY_MAX_SECONDS. If the provider asks for a
# longer wait (for example a daily limit) the app stops instead of waiting.
# LLM_MAX_ATTEMPTS=1 switches retrying off.
# ---------------------------------------------------------------------------
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_SECONDS=2
LLM_RETRY_MAX_SECONDS=30

# Privacy filtering for LLM-bound prompts. strict is recommended.
# strict: no sample values; Reviewer/Narrator disabled. standard: tokenizes flagged values.
# NOTE: free tiers of some providers may use your prompts to improve their
# models. Do not use standard mode with sensitive data on them.
PRIVACY_MODE=strict

# ---------------------------------------------------------------------------
# Which provider + model runs each agent. All on Groq here, each role with its
# own model. Groq's limits are per model, so spreading roles over different
# models also spreads the load. Active models change: run
#     python -m evals.check_providers --models
# to see what YOUR account can use today.
#
# Groq (official model page, checked 2026-10-19):
#   openai/gpt-oss-120b  production   openai/gpt-oss-20b  production
#   qwen/qwen3.8-27b     PREVIEW (can be withdrawn at short notice)
#   llama-3.1-8b-instant and llama-3.3-70b-versatile are now listed as
#   Enterprise only, so they are not used here.
# Only three general chat models are available, so two roles share one.
# ---------------------------------------------------------------------------
# Planner = the most important step. gpt-oss-20b passed the whole eval.
PLANNER_PROVIDER=groq
PLANNER_MODEL=openai/gpt-oss-120b

# Clarifier = asks one short question when a request is unclear. If it fails
# the question is still answered, so it is the safest place for a preview model.
CLARIFIER_PROVIDER=groq
CLARIFIER_MODEL=openai/gpt-oss-20b

# Reviewer = extra check. Runs only when PRIVACY_MODE=standard.
REVIEWER_PROVIDER=groq
REVIEWER_MODEL=openai/gpt-oss-20b

# Narrator = short written summary. Runs only when PRIVACY_MODE=standard.
NARRATOR_PROVIDER=groq
NARRATOR_MODEL=openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# Fallback (optional "Plan B"). Used ONLY when the main model still fails with
# a temporary problem after the retries above. A wrong key or model name is
# still shown to you. The same prompt is sent to the fallback, so privacy rules
# still apply. A fallback that is the same as the main model is ignored.
# ---------------------------------------------------------------------------
PLANNER_FALLBACK_PROVIDER=groq
PLANNER_FALLBACK_MODEL=openai/gpt-oss-120b

CLARIFIER_FALLBACK_PROVIDER=groq
CLARIFIER_FALLBACK_MODEL=openai/gpt-oss-20b

REVIEWER_FALLBACK_PROVIDER=groq
REVIEWER_FALLBACK_MODEL=openai/gpt-oss-20b

NARRATOR_FALLBACK_PROVIDER=groq
NARRATOR_FALLBACK_MODEL=openai/gpt-oss-20b

# Agents on/off. Reviewer/Narrator also need PRIVACY_MODE=standard to run.
ENABLE_REVIEWER=true
ENABLE_NARRATOR=true
ENABLE_CLARIFIER=true
