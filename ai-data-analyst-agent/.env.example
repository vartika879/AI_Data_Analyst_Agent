
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
MAX_UPLOAD_MB=5


# Reviewer agent (an extra LLM check). Leave GROQ_REVIEWER_MODEL empty to
# reuse GROQ_MODEL. Set ENABLE_REVIEWER=false to turn the Reviewer off.
GROQ_REVIEWER_MODEL=
ENABLE_REVIEWER=true


# Narrator agent (an extra LLM that writes a short summary). Leave
# GROQ_NARRATOR_MODEL empty to reuse GROQ_MODEL. ENABLE_NARRATOR=false turns it off.
GROQ_NARRATOR_MODEL=
ENABLE_NARRATOR=true


# Clarifier agent (asks you one question when your request is ambiguous).
# Leave GROQ_CLARIFIER_MODEL empty to reuse GROQ_MODEL.
# ENABLE_CLARIFIER=false turns it off.
GROQ_CLARIFIER_MODEL=
ENABLE_CLARIFIER=true